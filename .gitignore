# Runtime state and secrets must never be committed.
# Provision these paths at deployment time; keep only placeholders in Git.
keys/*
!keys/.gitkeep
data/vault/*
!data/vault/.gitkeep
data/*.db
logs/*
!logs/.gitkeep
models/*.joblib
models/*.pkl
.env
.env.*
!.env.example
